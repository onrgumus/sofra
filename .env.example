# Public base URL of this instance. The confirm link goes into an email, so it
# cannot be a relative path and it cannot be localhost in production.
SOFRA_BASE_URL=http://localhost:3000

# The buildings this instance matches in, as JSON. Without it you get the demo's
# two invented offices, which is not what anybody wants in production. The
# timezone is load-bearing: each office plans its own next working day in its
# own zone.
SOFRA_OFFICES=[{"id":"HQ","displayName":"Head office","timeZone":"Europe/Istanbul","meetingPoint":"Ground floor cafeteria"}]

# Postgres, which is what a serverless deployment needs: the filesystem there is
# ephemeral, so a SQLite file would be empty on every cold start. Supabase gives
# you this string under Project Settings, Database, Connection pooling.
DATABASE_URL=

# SQLite, for running on one machine. Ignored when DATABASE_URL is set.
# Without either, everything is in memory and a restart loses
# every tick, every reply, and the record of which invites have already gone
# out, which means the next cron run mails the whole building a second time.
SOFRA_DATABASE=./sofra.db

# Shared secret for the nightly matching job at /api/cron. Without it the
# endpoint refuses to run: anyone who can reach it could reshuffle tomorrow's
# tables and mail the whole company.
CRON_SECRET=

# Who may open the matching console, which shows every table and every reply for
# a whole office and whose buttons mail the building. Employee ids or emails,
# comma separated. Empty means nobody, which is the right way to fail.
SOFRA_ADMINS=

# Lets anyone sign in as anyone from the header. That is the point of a public
# demo and it is impersonation in a company, so it is off in production unless
# this is exactly "true".
SOFRA_DEMO_MODE=false

# How many times a password may be guessed, and over how long. Counted per
# username in the database, so it holds across serverless instances.
SOFRA_SIGNIN_MAX_ATTEMPTS=10
SOFRA_SIGNIN_WINDOW_MINUTES=15

# The demo's shared password. Anyone with the link can sign in with it, which is
# the point — it is a demo gate, not authentication.
SOFRA_DEMO_PASSWORD=1234

# Signs the session cookie, so an employee id cannot be forged in devtools.
# Change this for any deployment you care about.
SOFRA_SESSION_SECRET=

# Address for the demo account, so you receive its invites yourself while
# testing. Defaults to onur@example.com, which goes nowhere.
SOFRA_DEMO_EMAIL=

# Envelope sender for invites.
SOFRA_FROM_EMAIL=Sofra <sofra@example.com>

# Only needed once you swap ConsoleTransport for ResendTransport.
RESEND_API_KEY=

# --- Chat delivery (optional) ---
# Email always goes out because it needs nobody's permission. These switch on
# extra channels when the credentials exist, with no code change.

# Slack bot token. Scopes: mpim:write, chat:write, users:read.email.
# Sofra opens a group DM with exactly the four people and posts the invite there.
SLACK_BOT_TOKEN=

# Microsoft Graph app-only credentials, for a Teams group chat per table.
# Application permissions: Chat.Create and ChatMessage.Send, which need tenant
# admin consent — the one part of Sofra that does.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CAN_SEND_CHAT_MESSAGES=false

# Teams app id, from the manifest. Turns on activity feed notifications, which
# are the Teams delivery that works app-only, and gives them a tab to open.
TEAMS_APP_ID=

# --- Teams tab (optional) ---
# Renders Sofra inside Teams with the user already signed in. Needs an Entra ID
# app registration, but no bot and no application permissions — see
# teams/README.md. This is a much lighter ask than the Teams group chat above.

AAD_CLIENT_ID=
AAD_TENANT_ID=common

# Required when Sofra is framed by Teams: a SameSite=Lax cookie is not sent to a
# cross-site iframe, so the session would appear to vanish on every request.
# Implies Secure, so it needs HTTPS.
SOFRA_ALLOW_EMBEDDING=false

# Company sign-in. With these set, people use the account they already have and
# the shared demo password disappears. The endpoints come from the provider's
# own discovery document, so Entra, Okta, Google and Auth0 differ only here.
# Register https://your-instance/api/auth/oidc/callback as the redirect URI.
SOFRA_OIDC_ISSUER=
SOFRA_OIDC_CLIENT_ID=
SOFRA_OIDC_CLIENT_SECRET=

# Company sign-in. With these set, people use the account they already have and
# the shared demo password disappears. Endpoints come from the provider's own
# discovery document, so Entra, Okta, Google and Auth0 differ only here.
# Register https://your-instance/api/auth/oidc/callback as the redirect URI.
SOFRA_OIDC_ISSUER=
SOFRA_OIDC_CLIENT_ID=
SOFRA_OIDC_CLIENT_SECRET=
