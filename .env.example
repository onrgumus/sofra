# Copy to .env.local for development. In production, set these in the host's
# configuration, never in a file in the repository.

# --- Required --------------------------------------------------------------------

# PostgreSQL. The only store Sofra has: everything lives here.
DATABASE_URL=postgresql://sofra:password@127.0.0.1:5432/sofra

# Where people reach Sofra. Sign-in links and invites carry it, so in production
# it is the public https:// address.
SOFRA_BASE_URL=http://localhost:3000

# The first admins, by address, comma separated. They can sign in before any
# domain is allowed and cannot be removed from the console, so this is also the
# way back in. Everyone after them is granted in the console.
SOFRA_ADMINS=you@company.com

# Shared secret for the scheduler's endpoint. Without it /api/cron/tick refuses.
CRON_SECRET=

# Signs the company sign-in (OIDC) handshake. A long random string.
SOFRA_SESSION_SECRET=

# --- Who can sign in ---------------------------------------------------------------

# Domains whose mailboxes may sign in by emailed link, before an admin adds them
# in the console. The console's list and this one both count.
SOFRA_ALLOWED_DOMAINS=company.com

# --- Mail --------------------------------------------------------------------------

# outbox  keep mail in the database and show it at /dev/mailbox (development only)
# smtp    the company's mail server
# graph   Microsoft 365, sending as SOFRA_MAIL_SENDER with the Mail.Send permission
# resend  Resend's API
# Production refuses to start sending until this is set.
SOFRA_MAIL_TRANSPORT=outbox
SOFRA_FROM_EMAIL=Sofra <sofra@company.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# A PEM file with the CA a company-internal relay's certificate is issued by.
SMTP_CA_FILE=

SOFRA_MAIL_SENDER=
RESEND_API_KEY=

# --- Company sign-in (optional) -------------------------------------------------------
# Entra, Okta, Google or Auth0, by issuer URL. Register
# https://your-instance/api/auth/oidc/callback as the redirect URI.
SOFRA_OIDC_ISSUER=
SOFRA_OIDC_CLIENT_ID=
SOFRA_OIDC_CLIENT_SECRET=

# --- Teams (optional) -------------------------------------------------------------------
# See teams/README.md for the app registration and the package.

# Teams signs people in: the tab's app registration.
AAD_CLIENT_ID=
AAD_TENANT_ID=

# The Teams app's id, from the manifest: deep links and activity notifications.
TEAMS_APP_ID=

# Teams is the only way in: no email link, no company sign-in button.
SOFRA_TEAMS_ONLY=false
# Needed when Sofra is shown inside Teams but not Teams-only.
SOFRA_ALLOW_EMBEDDING=false

# The bot: invites and the evening question as cards in each person's chat.
# Defaults to the MS_* registration when TEAMS_BOT_ID is the same client id.
TEAMS_BOT_ID=
TEAMS_BOT_PASSWORD=
TEAMS_BOT_TENANT_ID=

# --- Microsoft Graph, app-only (optional) --------------------------------------------------
# One app registration for all of these, each switched on by its own setting:
#   directory sync    User.Read.All (+ GroupMember.Read.All for a pilot group)
#   Outlook hints     Calendars.Read
#   activity feed     TeamsActivity.Send
#   mail              Mail.Send
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- Directory sync (optional) ----------------------------------------------------------------
# entra: read people from the tenant. csv: from SOFRA_DIRECTORY_CSV. Unset: people
# sign in and fill in their own profile, which is enough on its own.
SOFRA_DIRECTORY=
SOFRA_DIRECTORY_CSV=
SOFRA_DIRECTORY_TOKEN=
SOFRA_ENTRA_GROUP_ID=
SOFRA_ENTRA_SENIORITY_ATTRIBUTE=

# --- Outlook office days (optional) -----------------------------------------------------------
# "outlook" reads each person's calendar for office days, shown as a hint and
# used to decide who gets the evening question. Never books anybody in.
SOFRA_CALENDAR_HINTS=

# --- Slack (optional) --------------------------------------------------------------------------
SLACK_BOT_TOKEN=
