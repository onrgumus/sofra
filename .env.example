# Public base URL of this instance. The confirm link goes into an email, so it
# cannot be a relative path and it cannot be localhost in production.
SOFRA_BASE_URL=http://localhost:3000

# Shared secret for the nightly matching job at /api/cron. Without it the
# endpoint refuses to run: anyone who can reach it could reshuffle tomorrow's
# tables and mail the whole company.
CRON_SECRET=

# The demo's shared password. Anyone with the link can sign in with it, which is
# the point — it is a demo gate, not authentication.
SOFRA_DEMO_PASSWORD=1234

# Signs the session cookie, so an employee id cannot be forged in devtools.
# Change this for any deployment you care about.
SOFRA_SESSION_SECRET=

# Envelope sender for invites.
SOFRA_FROM_EMAIL=Sofra <sofra@example.com>

# Only needed once you swap ConsoleTransport for ResendTransport.
RESEND_API_KEY=

# --- Chat delivery (optional) ---
# Email always goes out because it needs nobody's permission. These switch on
# extra channels when the credentials exist, with no code change.

# Slack bot token. Scopes: mpim:write, chat:write, users:read.email.
# Sofra opens a group DM with exactly the four people and posts the invite there.
SLACK_BOT_TOKEN=

# Microsoft Graph app-only credentials, for a Teams group chat per table.
# Application permissions: Chat.Create and ChatMessage.Send, which need tenant
# admin consent — the one part of Sofra that does.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CAN_SEND_CHAT_MESSAGES=false

# --- Teams tab (optional) ---
# Renders Sofra inside Teams with the user already signed in. Needs an Entra ID
# app registration, but no bot and no application permissions — see
# teams/README.md. This is a much lighter ask than the Teams group chat above.

AAD_CLIENT_ID=
AAD_TENANT_ID=common

# Required when Sofra is framed by Teams: a SameSite=Lax cookie is not sent to a
# cross-site iframe, so the session would appear to vanish on every request.
# Implies Secure, so it needs HTTPS.
SOFRA_ALLOW_EMBEDDING=false
