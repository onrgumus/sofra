{
  "name": "sofra",
  "version": "0.1.0",
  "description": "Diversity-aware lunch matching for hybrid offices. Works with any desk-booking system.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "simulate": "tsx src/sim/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"app/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.ts\" \"middleware.ts\" \"*.{json,md}\" \"docs/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"app/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.ts\" \"middleware.ts\" \"*.{json,md}\" \"docs/*.md\"",
    "teams:package": "tsx scripts/package-teams-app.ts",
    "e2e": "tsx scripts/e2e.ts",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.include=src/**"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@microsoft/teams-js": "^2.56.0",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "keywords": [
    "hybrid-work",
    "matching",
    "set-packing",
    "ics",
    "nextjs",
    "employee-experience"
  ],
  "author": "Onur Gumus",
  "private": true
}
