# Sofra in Teams, served from this laptop. Copy to .env.teams.local, fill in
# the blanks, then:
#
#   npm run dev:teams             https://localhost:3443, Teams-only
#   npm run teams:package:local   dist/sofra-teams.zip, to upload once
#
# Anything not set here comes from .env.local (the database, the admins).
# See teams/README.md.

SOFRA_TEAMS_ONLY=true
SOFRA_BASE_URL=https://localhost:3443

# From the Entra app registration's overview page. Its Application ID URI is
# api://localhost:3443/<AAD_CLIENT_ID>.
AAD_CLIENT_ID=
AAD_TENANT_ID=

# Generated once and kept: a new id uploads a second Sofra instead of updating.
TEAMS_APP_ID=
